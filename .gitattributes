# Line endings are normalised to LF in the repository and checked out native.
# Without this, files written by Python on Windows land as CRLF while git has
# stored LF, and `git status` reports permanently-modified files that contain
# no actual change.
* text=auto

# PowerShell is only ever run on Windows; keep CRLF in the working tree.
*.ps1 text eol=crlf

# Never touch these.
*.png binary

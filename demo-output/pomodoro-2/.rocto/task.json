{
  "title": "Pomodoro Timer with Stats",
  "goal": "Build a functional Pomodoro timer that tracks completed work sessions (tomatoes) and displays the count.",
  "features": [
    "Displays remaining time in mm:ss format for both work and break intervals",
    "Start, pause, and reset timer controls",
    "Alternates between 25-minute work and 5-minute break sessions",
    "Increments a tomato count each time a work session completes",
    "Shows current session type (Work/Break) via status label",
    "Visual feedback (e.g., color change) when transitioning between sessions",
    "Responsive layout that works on desktop and mobile",
    "All state is managed in-memory (no persistence needed)"
  ],
  "constraints": [
    "No external libraries, CDNs, or network requests",
    "All styling via vanilla CSS (no preprocessors)",
    "No build step or package manager",
    "All user interaction must be accessible via keyboard (tabindex, buttons)",
    "Create only a static HTML/CSS/JavaScript website",
    "Do not use external dependencies, CDNs, or network requests",
    "Create index.html, styles.css, script.js, and README.md"
  ],
  "ui_contract": [

    },
    {
      "test_id": "pause-button",
      "purpose": "Button to pause the timer"
    },
    {
      "test_id": "reset-button",
      "purpose": "Button to reset the timer to initial work state"
    },
    {
      "test_id": "session-type",
      "purpose": "Label indicating current session type (Work/Break)"
    },
    {
      "test_id": "tomato-count",
      "purpose": "Display of completed work sessions count"
    },
    {
      "test_id": "progress-bar",
      "purpose": "Visual progress indicator (percentage of current session)"
    }
  ],
